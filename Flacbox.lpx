#!name=Flacbox去广告
#!desc=移除 Flacbox 启动时的 Evermusic 跨应用推广页；如遇历史强缓存请卸载重装 App 或等待缓存过期
#!author=aaren22
#!homepage=https://github.com/aaren22/kill-ios-ad
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/github_00.png
#!raw-url=https://raw.githubusercontent.com/aaren22/kill-ios-ad/main/Flacbox.lpx
#!date=20260907
#############################################

[Script]
# 拦截 everappz.com 下所有的推广目录（如 evermusic_free_ios、evermusic_macos 等）
http-request ^https?:\/\/(?:www\.)?everappz\.com\/banners\/ script-path=https://raw.githubusercontent.com/aaren22/kill-ios-ad/main/Flacbox_ad_remove.js, timeout=10, tag=Flacbox-Evermusic推广页

[MITM]
hostname = www.everappz.com, everappz.com
