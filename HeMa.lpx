#!name=盒马去广告
#!desc=双层拦截盒马开屏广告：配置接口返回空数据 + 广告素材下载拦截；基于 HAR 抓包分析与 Kelee 插件规则比对
#!author=aaren22
#!homepage=https://github.com/aaren22/kill-ios-ad
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/github_00.png
#!raw-url=https://raw.githubusercontent.com/aaren22/kill-ios-ad/main/HeMa.lpx
#!date=20261012
#############################################

# 双层防御：
# 1) 配置层：开屏页的渲染查询接口直接返回空数据，App 拿到"无内容"就不展示开屏。
#    接口 mtop.wdk.render.querysinglepage（单页渲染查询），规则来源：Kelee 的
#    MrHema_remove_ads 插件（其复写列表第一条 reject_dict），已与抓包中的
#    MTOP 网关 acs-m.freshippo.com 对应上。
# 2) 素材层：盒马开屏广告是预下载模式——App 提前把广告视频/图片拉到本地，
#    下次冷启动播缓存。拦截素材下载路径作为兜底，配置层漏过的也播不出来。
#    证据：抓包中盒马 App 本体（UA=Hema4iPhone）启动时下载了
#    wdk-unity.alibabausercontent.com/frontend/common/20261011/<hash>.mp4（约 1.28MB）。
#
# 注意：已缓存的广告素材可能还会播一两次，等缓存轮换后失效；
# /frontend/common/ 也可能承载其他运营素材，拦截后个别活动图可能不显示，
# 不影响购物主功能。若盒马出现异常，先停用配置层那条规则再排查。

[Rewrite]
# 配置层：开屏渲染查询接口返回空数据
^https?:\/\/acs-m\.freshippo\.com\/gw\/mtop\.wdk\.render\.querysinglepage\/ reject-dict
# 素材层：开屏广告素材下载（视频/图片）
^https?:\/\/wdk-unity\.alibabausercontent\.com\/frontend\/common\/ reject

[MITM]
hostname = acs-m.freshippo.com, wdk-unity.alibabausercontent.com
