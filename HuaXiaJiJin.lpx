#!name=华夏基金去广告 v1.5
#!desc=开屏接口返回服务端真实空对象（id/activityDesc/imageList/skipBtnTxt 均为 null），不再使用 404 或 data:null；清空营销弹窗，屏蔽监控埋点。脚本带版本响应头，便于确认更新是否生效；跳过按钮效果需手机实测
#!author=aaren22
#!homepage=https://github.com/aaren22/kill-ios-ad
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/github_00.png
#!raw-url=https://raw.githubusercontent.com/aaren22/kill-ios-ad/main/HuaXiaJiJin.lpx
#!date=20261114
#!version=1.5
#############################################

[Rule]
# 性能监控上报（纯上报，无业务功能）
DOMAIN-SUFFIX,apm.chinaamc.com, REJECT
# 神策埋点上报（纯上报，无业务功能）
DOMAIN-SUFFIX,mips.chinaamc.com, REJECT
# 未知第三方探针（抓包中该请求已失败，非业务接口）
DOMAIN,dash.xn--cp3a08l.com, REJECT

[Script]
# 开屏下发接口：按服务器对旧版本客户端返回的空对象模拟 HTTP 200 响应
http-request ^https?:\/\/a\.chinaamc\.com\/mtrading-fm\/query\/splashAfter4_5_0\.json(?:\?|$) script-path=https://raw.githubusercontent.com/aaren22/kill-ios-ad/main/HuaXiaJiJin_ad_remove.js?v=1.5, timeout=10, tag=华夏基金-开屏广告-v1.5
# 弹窗控制接口：强制 popupBodyList 为空数组
http-response ^https?:\/\/a\.chinaamc\.com\/mtrading-fm\/query\/getPopupInfoNew\.json(?:\?|$) script-path=https://raw.githubusercontent.com/aaren22/kill-ios-ad/main/HuaXiaJiJin_ad_remove.js?v=1.5, requires-body=true, timeout=10, tag=华夏基金-弹窗-v1.5

[MITM]
hostname = a.chinaamc.com
