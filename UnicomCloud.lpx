#!name=联通云盘去开屏广告
#!desc=移除联通云盘开屏广告和启动首页 Flow 广告；首次使用建议清除一次 App 缓存
#!author=aaren22
#!homepage=https://github.com/aaren22/kill-ios-ad
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/github_00.png
#!raw-url=https://raw.githubusercontent.com/aaren22/kill-ios-ad/main/UnicomCloud.lpx
#!date=20260824
#############################################

[Rule]
# 拦截第三方统计与广告 SDK
DOMAIN-SUFFIX, zztfly.com, REJECT
DOMAIN, api.tusdk.com, REJECT

[Script]
# 本地 Mock 结构化成功响应，避免 App 因数据格式错误触发本地缓存广告兜底展示
http-request ^https?:\/\/s\.pan\.wo\.cn\/wohome\/open\/v1\/resource\/query\/open-screen\/app script-path=https://raw.githubusercontent.com/aaren22/kill-ios-ad/main/UnicomCloud_splash_remove.js, timeout=10, tag=联通云盘-开屏广告
http-request ^https?:\/\/s\.pan\.wo\.cn\/api\/bff\/resource\/query\/popupAndFlow script-path=https://raw.githubusercontent.com/aaren22/kill-ios-ad/main/UnicomCloud_splash_remove.js, timeout=10, tag=联通云盘-首页弹窗Flow广告

[MITM]
hostname = s.pan.wo.cn
